# Copy to .env (or just export these in your shell) before running the agent.

# Speech-to-text + text-to-speech — https://console.deepgram.com
DEEPGRAM_API_KEY=dg_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude reasoning + web search — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Login (recommended) ──
# Who can sign in. If you omit the password, a temporary one is printed in the
# console at startup. Set APP_PASSWORD (or APP_PASSWORD_HASH) to make it stick.
APP_USERNAME=daniel
APP_PASSWORD=change-me
# APP_PASSWORD_HASH=          # alternative: a werkzeug hash (plaintext never in env)
# Signs the session cookie — set a fixed value so logins survive restarts:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Set to 1 only when serving over HTTPS (e.g. behind a tunnel):
# SESSION_COOKIE_SECURE=1

# Optional personalisation (defaults shown)
# AGENT_NAME=Daniel Junior
# USER_NAME=Daniel
# PORT=4444
# MODEL=claude-opus-4-8        # or claude-sonnet-4-6 (faster) / claude-haiku-4-5 (fastest)
# HISTORY_FILE=history.json    # where conversation memory is persisted
