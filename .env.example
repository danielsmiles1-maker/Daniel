# Copy to .env (or just export these in your shell) before running the agent.

# Speech-to-text + text-to-speech — https://console.deepgram.com
DEEPGRAM_API_KEY=dg_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude reasoning + web search — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional personalisation (defaults shown)
# AGENT_NAME=Ada
# USER_NAME=Daniel
# PORT=4444
# MODEL=claude-opus-4-8        # or claude-sonnet-4-6 (faster) / claude-haiku-4-5 (fastest)
# HISTORY_FILE=history.json    # where conversation memory is persisted
